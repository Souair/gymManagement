<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.gym.mapper.GymMemberMapper">
    
    <resultMap type="GymMember" id="GymMemberResult">
        <result property="memberId"    column="member_id"    />
        <result property="cardNo"    column="card_no"    />
        <result property="name"    column="name"    />
        <result property="phone"    column="phone"    />
        <result property="gender"    column="gender"    />
        <result property="age"    column="age"    />
        <result property="height"    column="height"    />
        <result property="weight"    column="weight"    />
        <result property="target"    column="target"    />
        <result property="cardType"    column="card_type"    />
        <result property="classHours"    column="class_hours"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectGymMemberVo">
        select member_id, card_no, name, phone, gender, age, height, weight, target, card_type, class_hours, start_date, end_date, del_flag, create_by, create_time, update_by, update_time, remark from gym_member
    </sql>

    <select id="selectGymMemberList" parameterType="GymMember" resultMap="GymMemberResult">
        <include refid="selectGymMemberVo"/>
        <where>  
            <if test="cardNo != null  and cardNo != ''"> and card_no = #{cardNo}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="gender != null  and gender != ''"> and gender = #{gender}</if>
            <if test="age != null "> and age = #{age}</if>
            <if test="height != null "> and height = #{height}</if>
            <if test="weight != null "> and weight = #{weight}</if>
            <if test="target != null  and target != ''"> and target = #{target}</if>
            <if test="cardType != null  and cardType != ''"> and card_type = #{cardType}</if>
            <if test="classHours != null "> and class_hours = #{classHours}</if>
            <if test="startDate != null "> and start_date = #{startDate}</if>
            <if test="endDate != null "> and end_date = #{endDate}</if>
        </where>
    </select>
    
    <select id="selectGymMemberByMemberId" parameterType="Long" resultMap="GymMemberResult">
        <include refid="selectGymMemberVo"/>
        where member_id = #{memberId}
    </select>

    <insert id="insertGymMember" parameterType="GymMember" useGeneratedKeys="true" keyProperty="memberId">
        insert into gym_member
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="cardNo != null">card_no,</if>
            <if test="name != null">name,</if>
            <if test="phone != null">phone,</if>
            <if test="gender != null">gender,</if>
            <if test="age != null">age,</if>
            <if test="height != null">height,</if>
            <if test="weight != null">weight,</if>
            <if test="target != null and target != ''">target,</if>
            <if test="cardType != null">card_type,</if>
            <if test="classHours != null">class_hours,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="cardNo != null">#{cardNo},</if>
            <if test="name != null">#{name},</if>
            <if test="phone != null">#{phone},</if>
            <if test="gender != null">#{gender},</if>
            <if test="age != null">#{age},</if>
            <if test="height != null">#{height},</if>
            <if test="weight != null">#{weight},</if>
            <if test="target != null and target != ''">#{target},</if>
            <if test="cardType != null">#{cardType},</if>
            <if test="classHours != null">#{classHours},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateGymMember" parameterType="GymMember">
        update gym_member
        <trim prefix="SET" suffixOverrides=",">
            <if test="cardNo != null">card_no = #{cardNo},</if>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="age != null">age = #{age},</if>
            <if test="height != null">height = #{height},</if>
            <if test="weight != null">weight = #{weight},</if>
            <if test="target != null and target != ''">target = #{target},</if>
            <if test="cardType != null">card_type = #{cardType},</if>
            <if test="classHours != null">class_hours = #{classHours},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where member_id = #{memberId}
    </update>

    <delete id="deleteGymMemberByMemberId" parameterType="Long">
        delete from gym_member where member_id = #{memberId}
    </delete>

    <delete id="deleteGymMemberByMemberIds" parameterType="String">
        delete from gym_member where member_id in 
        <foreach item="memberId" collection="array" open="(" separator="," close=")">
            #{memberId}
        </foreach>
    </delete>
</mapper>